# Open Claude Cowork - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required API Keys
# ============================================

# Anthropic API Key (required for Claude provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Composio API Key (required for tool integration)
COMPOSIO_API_KEY=your-composio-key-here

# ============================================
# Server Configuration
# ============================================

# Server port (default: 3001)
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ============================================
# CORS Configuration
# ============================================

# Allowed origins (comma-separated)
# In development, localhost is allowed by default
# In production, set this to your domain(s)
# CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# ============================================
# Supabase Configuration (optional)
# ============================================

# Supabase project URL
# SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (for client-side auth)
# SUPABASE_ANON_KEY=your-anon-key

# Supabase service key (for server-side operations)
# SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# Docling Sidecar Configuration (optional)
# ============================================

# Docling service URL (if using document processing)
# DOCLING_URL=http://localhost:8765

# ============================================
# Feature Flags (optional)
# ============================================

# Enable browser automation features
# ENABLE_BROWSER=true

# Enable document processing
# ENABLE_DOCLING=true
