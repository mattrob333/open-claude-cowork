{
  "name": "open-claude-cowork",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:server": "cd server && npm start",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "cd renderer && npm run build",
    "start": "electron .",
    "server": "npm start --prefix server",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "description": "Electron chat app with Claude Agent SDK and Opencode SDK support",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.7",
    "@opencode-ai/sdk": "latest",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-reload": "^2.0.0-alpha.1"
  }
}
